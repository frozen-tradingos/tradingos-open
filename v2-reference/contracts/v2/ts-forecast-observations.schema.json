{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-os-v2.local/contracts/v2/ts-forecast-observations.schema.json",
  "title": "Trading OS V2 TS Forecast Observations v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "component",
    "forecast_run_id",
    "forecast_hash",
    "timezone",
    "window_start",
    "window_end",
    "complete",
    "source_hashes",
    "symbols",
    "observation_hash"
  ],
  "properties": {
    "contract_version": {"type": "string", "const": "v2"},
    "component": {"type": "string", "const": "TS_FORECAST_OBSERVATIONS"},
    "forecast_run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{10}$"
    },
    "forecast_hash": {"$ref": "#/$defs/hash"},
    "timezone": {"type": "string", "const": "America/Los_Angeles"},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "complete": {"type": "boolean"},
    "source_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/hash"}
    },
    "symbols": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SPY", "QQQ"],
      "properties": {
        "SPY": {"$ref": "#/$defs/bars"},
        "QQQ": {"$ref": "#/$defs/bars"}
      }
    },
    "observation_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bars": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/bar"}
    },
    "bar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closed_at", "open", "high", "low", "close", "vwap"],
      "properties": {
        "closed_at": {"type": "string", "format": "date-time"},
        "open": {"type": "number", "exclusiveMinimum": 0},
        "high": {"type": "number", "exclusiveMinimum": 0},
        "low": {"type": "number", "exclusiveMinimum": 0},
        "close": {"type": "number", "exclusiveMinimum": 0},
        "vwap": {
          "oneOf": [
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
