{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "role",
    "path",
    "confidence",
    "summary",
    "key_levels",
    "targets",
    "invalidation",
    "hypotheses",
    "data_gaps"
  ],
  "properties": {
    "contract_version": {"type": "string", "const": "v1"},
    "role": {"type": "string", "enum": ["TS"]},
    "path": {
      "type": "string",
      "enum": ["bullish", "bearish", "range", "uncertain"]
    },
    "confidence": {"type": "integer", "minimum": 0, "maximum": 10},
    "summary": {"type": "string"},
    "key_levels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "label", "value", "basis"],
        "properties": {
          "symbol": {"type": "string", "enum": ["SPY", "QQQ"]},
          "label": {"type": "string"},
          "value": {"type": "number"},
          "basis": {"type": "string"}
        }
      }
    },
    "targets": {"type": "array", "items": {"type": "string"}},
    "invalidation": {"type": "array", "items": {"type": "string"}},
    "hypotheses": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "assessment", "reason"],
        "properties": {
          "id": {"type": "integer", "minimum": 1, "maximum": 12},
          "assessment": {
            "type": "string",
            "enum": ["supports", "contradicts", "neutral", "insufficient_data"]
          },
          "reason": {"type": "string"}
        }
      }
    },
    "data_gaps": {"type": "array", "items": {"type": "string"}},
    "earnings_day_coverage": {
      "$ref": "#/$defs/earnings_day_coverage"
    }
  },
  "$defs": {
    "earnings_day_coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "symbol", "treatment", "summary"],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9.-]{0,14}$"
          },
          "treatment": {
            "type": "string",
            "const": "SCHEDULE_RISK_ONLY"
          },
          "summary": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
