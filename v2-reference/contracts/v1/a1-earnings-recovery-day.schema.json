{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-os-v2.local/contracts/v1/a1-earnings-recovery-day.schema.json",
  "title": "Trading OS V2 A1 Earnings Recovery Day v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "component",
    "scheduled_day",
    "sunday_day",
    "generated_at",
    "daily_delivery_key",
    "recovery_delivery_key",
    "recovery_run_id",
    "recovery_packet_hash",
    "recovery_information_hash",
    "recovery_evidence_day",
    "source_status",
    "non_baseline",
    "formal_sunday_baseline",
    "actionable",
    "ts_causal_eligible",
    "candidates",
    "recovery_hash"
  ],
  "properties": {
    "contract_version": {"type": "string", "const": "v1"},
    "component": {"type": "string", "const": "A1_EARNINGS_RECOVERY_DAY"},
    "scheduled_day": {"$ref": "#/$defs/day"},
    "sunday_day": {"$ref": "#/$defs/day"},
    "generated_at": {"type": "string", "format": "date-time"},
    "daily_delivery_key": {
      "type": "string",
      "pattern": "^a1-earnings-day-recovery-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "recovery_delivery_key": {
      "type": "string",
      "pattern": "^a1-earnings-weekly-recovery-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "recovery_run_id": {"$ref": "#/$defs/run_id"},
    "recovery_packet_hash": {"$ref": "#/$defs/hash"},
    "recovery_information_hash": {"$ref": "#/$defs/hash"},
    "recovery_evidence_day": {"$ref": "#/$defs/day"},
    "source_status": {"type": "string", "const": "HEALTHY"},
    "non_baseline": {"type": "boolean", "const": true},
    "formal_sunday_baseline": {"type": "boolean", "const": false},
    "actionable": {"type": "boolean", "const": false},
    "ts_causal_eligible": {"type": "boolean", "const": false},
    "candidates": {
      "type": "array",
      "maxItems": 20,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "recovery_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{10}$"
    },
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "nullable_number": {"type": ["number", "null"]},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "date",
        "session",
        "eps_estimate",
        "revenue_estimate",
        "source",
        "confidence"
      ],
      "properties": {
        "symbol": {"type": "string", "pattern": "^[A-Z0-9.-]+$"},
        "date": {"$ref": "#/$defs/day"},
        "session": {"type": "string", "enum": ["BMO", "AMC", "UNKNOWN"]},
        "eps_estimate": {"$ref": "#/$defs/nullable_number"},
        "revenue_estimate": {"$ref": "#/$defs/nullable_number"},
        "source": {"type": "string", "const": "Finnhub Earnings Calendar"},
        "confidence": {"type": "string", "const": "scheduled_event"}
      }
    }
  }
}
