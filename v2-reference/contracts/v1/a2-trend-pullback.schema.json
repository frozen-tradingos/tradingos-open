{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "status",
    "policy",
    "trade_action",
    "symbols"
  ],
  "properties": {
    "contract_version": {"type": "string", "const": "v1"},
    "status": {
      "type": "string",
      "enum": ["HEALTHY", "DEGRADED", "INACTIVE"]
    },
    "policy": {
      "type": "string",
      "const": "TREND_ALIGNED_PULLBACK_ONLY"
    },
    "trade_action": {"type": "boolean", "const": false},
    "symbols": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "SPY": {"$ref": "#/$defs/symbol"},
        "QQQ": {"$ref": "#/$defs/symbol"}
      }
    }
  },
  "$defs": {
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligibility", "reason", "evidence"],
      "properties": {
        "eligibility": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_time",
        "regime",
        "context_hash",
        "call",
        "put"
      ],
      "properties": {
        "data_time": {"type": "string"},
        "regime": {
          "type": "string",
          "enum": [
            "TREND_UP",
            "TREND_DOWN",
            "NARROW_RANGE",
            "WIDE_CHOP",
            "V_REVERSAL_UP",
            "V_REVERSAL_DOWN",
            "FALSE_BREAKOUT",
            "FALSE_BREAKDOWN",
            "TRANSITION",
            "UNKNOWN"
          ]
        },
        "context_hash": {
          "type": "string",
          "pattern": "^(|[0-9a-f]{64})$"
        },
        "call": {"$ref": "#/$defs/assessment"},
        "put": {"$ref": "#/$defs/assessment"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "HEALTHY"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "symbols": {"required": ["SPY", "QQQ"]}
        }
      }
    }
  ]
}
